# Ambiente EXCLUSIVO da suíte de testes (jest.config.js carrega este arquivo, nunca o .env).
# Aponta para um Postgres local descartável (o mesmo container do docker-compose.yml,
# porém num banco separado: "pipelines_test", criado automaticamente por
# tests/globalSetup.js). NENHUMA credencial real deve entrar aqui — as chaves de serviços
# externos ficam vazias de propósito para os testes nunca tocarem produção nem disparar
# e-mail/integração de verdade. tests/assertTestEnv.ts recusa rodar se DATABASE_URL
# parecer de produção ou se RESEND_API_KEY estiver preenchida.

NODE_ENV=test
PORT=3001

DATABASE_URL=postgres://pipelines:pipelines@localhost:5432/pipelines_test
DATABASE_SSL=false

JWT_SECRET=test-only-jwt-secret-nao-usar-em-producao
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN_DAYS=7

CREDENTIALS_ENCRYPTION_KEY=test-only-credentials-encryption-key-32b-min

CORS_ORIGIN=http://localhost:5173
COOKIE_CROSS_SITE=false

IMOVIEW_BASE_URL=
IMOVIEW_API_KEY=

STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Vazio de propósito: com RESEND_API_KEY em branco o MailService lança em vez de enviar,
# e assertTestEnv.ts bloqueia a suíte se alguém preencher isto.
RESEND_API_KEY=
MAIL_FROM=Pipelines <test@example.test>
FRONTEND_URL=http://localhost:5173
