NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://pipelines:pipelines@localhost:5432/pipelines
# true quando o Postgres é gerenciado (Supabase, Neon...) e exige SSL. Deixe em
# branco/false para o Postgres local via Docker.
DATABASE_SSL=false

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN_DAYS=7

CREDENTIALS_ENCRYPTION_KEY=change-me-32-bytes-min-secret-key

CORS_ORIGIN=http://localhost:5173
# true quando o frontend e o backend estão em domínios diferentes (ex.: Render),
# para o cookie de refresh token usar SameSite=None em vez de Lax. Deixe em
# branco/false em dev local (frontend e backend passam pelo mesmo domínio via
# proxy do Vite).
COOKIE_CROSS_SITE=false

IMOVIEW_BASE_URL=
IMOVIEW_API_KEY=

# Armazenamento dos anexos dos cards: "local" grava em backend/uploads (padrão,
# usado em dev e com Docker); "supabase" envia para um bucket do Supabase Storage
# (necessário em produção no Render, onde o disco não é persistente).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# E-mail de "esqueci minha senha" via Resend (resend.com). Sem chave configurada,
# o pedido de redefinição de senha falha ao tentar enviar o e-mail.
RESEND_API_KEY=
# Remetente do e-mail. Sem domínio verificado no Resend, use o padrão de teste
# deles (onboarding@resend.dev) — só envia pro e-mail da conta Resend, não pra
# qualquer usuário. Pra mandar pra qualquer e-mail, verifique um domínio no Resend
# e troque aqui (ex.: "Pipelines <no-reply@seudominio.com>").
MAIL_FROM=Pipelines <onboarding@resend.dev>
# URL do frontend, usada pra montar o link de redefinição de senha. Se não definir,
# reaproveita o CORS_ORIGIN.
FRONTEND_URL=

# Scans periódicos (SLA das fases + automações recorrentes):
#   interval (padrão) = setInterval dentro do processo do backend
#   off               = não roda in-process; um cron externo deve bater em
#                       POST /api/v1/internal/run-scans (ver DEPLOY.md)
BACKGROUND_SCANS=interval
# Segredo do cabeçalho X-Internal-Secret para POST /api/v1/internal/run-scans.
# Sem valor, o endpoint interno responde 404.
INTERNAL_API_SECRET=
