# Variáveis do deploy intranet via docker-compose (raiz do repo). Para dev local
# sem Docker, use backend/.env.example. Copie este arquivo para ".env" e
# preencha os valores antes de rodar "docker compose up -d --build".

# Credenciais do Postgres (container "postgres" do docker-compose.yml, não
# exposto na LAN — só 127.0.0.1).
POSTGRES_USER=pipelines
POSTGRES_PASSWORD=troque_por_um_valor_aleatorio_forte
POSTGRES_DB=pipelines

# Segredos da aplicação — gere valores aleatórios (ex.: openssl rand -base64 32).
JWT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# Credenciais do primeiro usuário admin, criadas pelo seed no boot (troque a
# senha depois do primeiro login).
SEED_ADMIN_EMAIL=admin@perezimoveis.com
SEED_ADMIN_PASSWORD=

# Integração Imoview (opcional — sem isso, as funcionalidades que dependem da
# API do Imoview ficam indisponíveis).
IMOVIEW_BASE_URL=
IMOVIEW_API_KEY=

# E-mail de "esqueci minha senha" via Resend (resend.com). Sem chave, o pedido
# de redefinição de senha falha ao tentar enviar o e-mail.
RESEND_API_KEY=
MAIL_FROM=Pipelines <onboarding@resend.dev>

# Segredo do cabeçalho X-Internal-Secret do endpoint POST
# /api/v1/internal/run-scans. Não é usado no deploy intranet (BACKGROUND_SCANS
# já roda in-process via setInterval, ver docker-compose.yml) — pode deixar em
# branco.
INTERNAL_API_SECRET=
